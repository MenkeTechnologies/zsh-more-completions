_claude_auth() {
  local curcontext=$curcontext state line ret=1
  typeset -A opt_args
  local -a cmds
  cmds=(
    'login:Sign in to your Anthropic account'
    'logout:Log out from your Anthropic account'
    'status:Show authentication status'
  )
  _arguments -C -s \
    '(-h --help)'{-h,--help}'[Display help for command]' \
    '1: :{_describe -t commands "claude auth command" cmds}' \
    '*::arg:->args' && ret=0
  case $state in
    (args)
      curcontext="${curcontext%:*:*}:claude-auth-$words[1]:"
      case $words[1] in
        (login) _claude_auth_login && ret=0 ;;
        (logout) _claude_auth_logout && ret=0 ;;
        (status) _claude_auth_status && ret=0 ;;
      esac
      ;;
  esac
  return ret
}

