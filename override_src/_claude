    '--dry-run[List what would be deleted without deleting anything]' \
    '(-h --help)'{-h,--help}'[Display help for command]' \
    '(-i --interactive)'{-i,--interactive}'[Prompt for each item before deleting]' \
    '(-y --yes)'{-y,--yes}'[Skip confirmation prompt]' \
    '1::path:_files'
}

_claude_remote_control() {
  _arguments -s \
    '(-c --continue --session-id)--name[Name for the session (shown in claude.ai/code)]:name:' \
    '--remote-control-session-name-prefix[Prefix for auto-generated session names (default: hostname)]:prefix:' \
    '(-c --continue --session-id --name --spawn --capacity)'{-c,--continue}'[Reattach to the session `claude remote-control` last recorded for this directory]' \
    '(-c --continue --name --spawn --capacity)--session-id[Reattach to a specific session by ID]:id:' \
    '--permission-mode[Permission mode for spawned sessions]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)' \
    '(--no-chrome)--chrome[Enable Claude in Chrome for spawned sessions]' \
    '(--chrome)--no-chrome[Disable Claude in Chrome for spawned sessions]' \
    '(-d --debug)'{-d,--debug=}'[Enable debug mode with optional category filtering (e.g. --debug=api,hooks)]::filter:' \
    '--debug-file[Write debug logs to file]:path:_files' \
    '(-v --verbose)'{-v,--verbose}'[Enable verbose output]' \
    '(- *)'{-h,--help}'[Show this help]' \
    '--spawn=[Spawn mode]:mode:(same-dir worktree session)' \
    '--capacity=[Max concurrent sessions in worktree or same-dir mode (default: 32)]:N:' \
    '(--no-create-session-in-dir)--create-session-in-dir[Pre-create a session in the current directory (default: on)]' \
    '(--create-session-in-dir)--no-create-session-in-dir[Do not pre-create a session in the current directory]'
}

_claude_respawn() {
  _arguments -s \
    '1:id:'
}

_claude_rm() {
  _arguments -s \
    '1:id:' \
    '2::--discard-unpushed <commit>@<worktree-id>:' \
    '3::--force-remove-worktree <worktree-id>:'
}

_claude_setup_token() {
  _arguments -s \
    '(-h --help)'{-h,--help}'[Display help for command]'
}

_claude_stop() {
  _arguments -s \
    '1:id:'
}

_claude_ultrareview() {
  _arguments -s \
    '(-h --help)'{-h,--help}'[Display help for command]' \
    '--json[Print the raw bugs.json payload instead of formatted findings]' \
    '--no-post[Do not post the findings to the PR (the default; accepted for parity with the /ultrareview and /code-review ultra flags)]' \
    '--post[Post the finished review'\''s findings to the PR as you (PR targets only; one plain comment, not a review)]' \
    '--timeout[Maximum minutes to wait for the review to finish]:minutes:' \
    '1::target:'
}

_claude_update() {
  _arguments -s \
    '(-h --help)'{-h,--help}'[Display help for command]'
}

_claude() {
  local curcontext=$curcontext state line ret=1
  typeset -A opt_args
  local -a cmds
  cmds=(
    'agents:Manage background agents'
    'attach:Open a background session in this terminal. <id> is the short id that `claude --bg` prints and `claude agents` lists'
    'auth:Manage authentication'
    'auto-mode:Inspect or reset auto mode classifier configuration'
    'doctor:Check the health of your Claude Code installation. Reads settings files in the current directory without a trust prompt. For a full checkup that can also fix...'
    'gateway:Run the enterprise auth/telemetry gateway'
    'import:Import config from another AI coding agent into Claude Code'
    'install:Install Claude Code native build. Use \[target\] to specify version (stable, latest, or specific version)'
    'logs:Print a background session'\''s recent terminal output'
    'mcp:Configure and manage MCP servers'
    'plugin:Manage Claude Code plugins'
    'plugins:Manage Claude Code plugins'
    'purge:Delete all Claude Code state for a project (transcripts, tasks, file history, config entry)'
    'remote-control:Control local sessions from claude.ai/code or the Claude mobile app'
    'respawn:Restart a background session, or all of them with --all, so it runs the current Claude Code version'
    'rm:Delete a background session, and its worktree when that is safe. Works on sessions that have already exited'
    'setup-token:Set up a long-lived authentication token (requires Claude subscription)'
    'stop:Stop a background session. Its conversation is kept\: `claude attach <id>` opens it again, `claude --resume` works once it is stopped'
    'kill:Stop a background session. Its conversation is kept\: `claude attach <id>` opens it again, `claude --resume` works once it is stopped'
    'ultrareview:Run a cloud-hosted multi-agent code review of the current branch (or a PR number / base branch) and print the findings'
    'update:Check for updates and install if available'
    'upgrade:Check for updates and install if available'
  )
  _arguments -C -s \
    '*--add-dir[Additional directories to allow tool access to]:directories:_files -/' \
    '--agent[Agent for the current session. Overrides the '\''agent'\'' setting]:agent:' \
    '--agents[JSON object defining custom agents, or with --print the path to a file that holds one (e.g. '\''{"reviewer": {"description": "Reviews code", "prompt": "You are ...]:json-or-file:_files' \
    '--allow-dangerously-skip-permissions[Enable bypassing all permission checks as an option, without it being enabled by default. Recommended only for sandboxes with no internet access]' \
    '*--allowedTools[Comma or space-separated list of tool names to allow (e.g. "Bash(git *) Edit")]:tools:' '*--allowed-tools[Comma or space-separated list of tool names to allow (e.g. "Bash(git *) Edit")]:tools:' \
    '--append-system-prompt[Append a system prompt to the default system prompt]:prompt:' \
    '--autocompact[Auto-compact window size (auto, or 100k–1M tokens)]:auto|tokens:' \
    '--ax-screen-reader[Render screen-reader friendly output (flat text, no decorative borders or animations)]' \
    '(--bg --background)'{--bg,--background}'[Start the session in the background and return immediately. Prints the id that `claude attach`, `logs`, `stop` and `rm` take; `claude agents` lists them. Wit...]' \
    '--bare[Minimal mode: skip hooks (those defined in settings and by installed plugins; features built into Claude Code are unaffected), LSP, plugin sync, attribution,...]' \
    '*--betas[Beta headers to include in API requests (API key users only)]:betas:' \
    '--brief[Enable SendUserMessage tool for agent-to-user communication]' \
    '--chrome[Enable Claude in Chrome integration]' \
    '--cloud[Create a cloud session with the given description, or attach to an existing one by session ID or claude.ai/code URL]::description|session_id|url:' \
    '(-c --continue)'{-c,--continue}'[Continue the most recent conversation in the current directory]' \
    '--dangerously-skip-permissions[Bypass all permission checks. Recommended only for sandboxes with no internet access]' \
    '(-d --debug)'{-d,--debug}'[Enable debug mode with optional category filtering (e.g., "api,hooks" or "!1p,!file")]::filter:' \
    '--debug-file[Write debug logs to a specific file path (implicitly enables debug mode)]:path:_files' \
    '--desktop[Open in the Claude Desktop app instead of the terminal (with --continue or --resume <id> to pick the session)]' \
    '--disable-slash-commands[Disable all skills]' \
    '*--disallowedTools[Comma or space-separated list of tool names to deny (e.g. "Bash(git *) Edit")]:tools:' '*--disallowed-tools[Comma or space-separated list of tool names to deny (e.g. "Bash(git *) Edit")]:tools:' \
    '--effort[Effort level for the current session (low, medium, high, xhigh, max)]:level:(low medium high xhigh max)' \
    '--environment[Create a new cloud session that runs on the given self-hosted environment (ccpool_...)]:environment_id:' \
    '--exclude-dynamic-system-prompt-sections[Move per-machine sections (cwd, env info, memory paths, git status) from the system prompt into the first user message. Improves cross-user prompt-cache reus...]' \
    '--fallback-model[Enable automatic fallback to specified model(s) when the default model is overloaded or not available. Accepts a comma-separated list to try each in order. R...]:model:' \
    '*--file[File resources to download at startup. Format: file_id:relative_path (e.g., --file file_abc:doc.txt file_def:img.png)]:specs:_files' \
    '--fork-session[When resuming, create a new session ID instead of reusing the original (use with --resume or --continue)]' \
    '--forward-subagent-text[Forward subagent text and thinking blocks as assistant/user messages with parent_tool_use_id set (only works with --print and --output-format=stream-json)]' \
    '--from-pr[Resume a session linked to a PR by PR number/URL, or open interactive picker with optional search term]::value:' \
    '(-h --help)'{-h,--help}'[Display help for command]' \
    '--ide[Automatically connect to IDE on startup if exactly one valid IDE is available]' \
    '--include-hook-events[Include all hook lifecycle events in the output stream (only works with --output-format=stream-json)]' \
    '--include-partial-messages[Include partial message chunks as they arrive (only works with --print and --output-format=stream-json)]' \
    '--input-format[Input format (only works with --print): "text" (default), or "stream-json" (realtime streaming input)]:format:(text stream-json)' \
    '--json-schema[JSON Schema for structured output validation. Example: {"type":"object","properties":{"name":{"type":"string"}},"required":\["name"\]}]:schema:' \
    '--max-budget-usd[Maximum dollar amount to spend on API calls (only works with --print)]:amount:' \
    '*--mcp-config[Load MCP servers from JSON files or strings (space-separated)]:configs:' \
    '--model[Model for the current session. Provide an alias for the latest model (e.g. '\''fable'\'', '\''opus'\'', or '\''sonnet'\'') or a model'\''s full name]:model:' \
    '(-n --name)'{-n,--name}'[Set a display name for this session (shown in the prompt box, /resume picker, and terminal title)]:name:' \
    '--no-chrome[Disable Claude in Chrome integration]' \
    '--no-session-persistence[Disable session persistence - sessions will not be saved to disk and cannot be resumed (only works with --print)]' \
    '--output-format[Output format (only works with --print): "text" (default), "json" (single result), or "stream-json" (realtime streaming)]:format:(text json stream-json)' \
    '--permission-mode[Permission mode to use for the session]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '--permission-prompts[Who answers permission prompts with --print: "host" (the SDK host or --permission-prompt-tool) or "none" (nobody: anything that would prompt is denied automa...]:target:(host none)' \
    '*--plugin-dir[Load a plugin from a directory or .zip for this session only; a folder of plugins loads each child (repeatable: --plugin-dir A --plugin-dir B.zip)]:path:_files -/' \
    '*--plugin-url[Fetch a plugin .zip from a URL for this session only (repeatable: --plugin-url A --plugin-url B)]:url:' \
    '(-p --print)'{-p,--print}'[Print response and exit (useful for pipes). Note: The workspace trust dialog is skipped when Claude is run in non-interactive mode (via -p, or when stdout is...]' \
    '--prompt-suggestions[Enable prompt suggestions. In print/SDK mode, emits a prompt_suggestion message after each turn with a predicted next user prompt]::value:(true false 1 0 yes no on off)' \
    '--remote-control[Start an interactive session with Remote Control enabled (optionally named)]::name:' \
    '--remote-control-session-name-prefix[Prefix for auto-generated Remote Control session names]:prefix:' \
    '--replay-user-messages[Re-emit user messages from stdin back on stdout for acknowledgment (only works with --input-format=stream-json and --output-format=stream-json)]' \
    '--restricted[Restricted mode: removes the built-in tools that run commands or code (Bash, PowerShell, REPL and the other code-running tools) and WebFetch unless --tools n...]' \
    '(-r --resume)'{-r,--resume}'[Resume a conversation by session ID, or open interactive picker with optional search term]::value:' \
    '--safe-mode[Start with all customizations (CLAUDE.md, skills, installed plugins, hooks, MCP servers, custom commands and agents, output styles, workflows, custom themes,...]' \
    '--session-id[Use a specific session ID for the conversation (must be a valid UUID)]:uuid:' \
    '--setting-sources[Comma-separated list of setting sources to load (user, project, local)]:sources:(user project local)' \
    '--settings[Path to a settings JSON file or a JSON string to load additional settings from]:file-or-json:_files' \
    '--strict-mcp-config[Only use MCP servers from --mcp-config, ignoring all other MCP configurations]' \
    '--system-prompt[System prompt to use for the session]:prompt:' \
    '--system-prompt-snapshot[Record the system prompt once per conversation and reuse it verbatim on every request and resume. on (the default): the prompt is rendered on the conversatio...]:on|off:(on off)' \
    '--teleport[Resume a teleport session, optionally specify session ID]::session:' \
    '--tmux[Create a tmux session for the worktree (requires --worktree). Uses iTerm2 native panes when available; use --tmux=classic for traditional tmux]' \
    '*--tools[Specify the list of available tools from the built-in set. Use "" to disable all tools, "default" to use all tools, or specify tool names (e.g. "Bash,Edit,Re...]:tools:' \
    '--verbose[Override verbose mode setting from config]' \
    '(-v --version)'{-v,--version}'[Output the version number]' \
    '(-w --worktree)'{-w,--worktree}'[Create a new git worktree for this session (optionally specify a name)]::name:' \
    '1: :{_describe -t commands "claude command" cmds}' \
    '*::arg:->args' && ret=0
  case $state in
    (args)
      curcontext="${curcontext%:*:*}:claude-$words[1]:"
      case $words[1] in
        (agents) _claude_agents && ret=0 ;;
        (attach) _claude_attach && ret=0 ;;
        (auth) _claude_auth && ret=0 ;;
        (auto-mode) _claude_auto_mode && ret=0 ;;
        (doctor) _claude_doctor && ret=0 ;;
        (gateway) _claude_gateway && ret=0 ;;
        (import) _claude_import && ret=0 ;;
        (install) _claude_install && ret=0 ;;
        (logs) _claude_logs && ret=0 ;;
        (mcp) _claude_mcp && ret=0 ;;
        (plugin|plugins) _claude_plugin && ret=0 ;;
        (purge) _claude_purge && ret=0 ;;
        (remote-control) _claude_remote_control && ret=0 ;;
        (respawn) _claude_respawn && ret=0 ;;
        (rm) _claude_rm && ret=0 ;;
        (setup-token) _claude_setup_token && ret=0 ;;
        (stop|kill) _claude_stop && ret=0 ;;
        (ultrareview) _claude_ultrareview && ret=0 ;;
        (update|upgrade) _claude_update && ret=0 ;;
      esac
      ;;
  esac
  return ret
}

_claude "$@"
