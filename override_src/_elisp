#compdef elisp

# Zsh completion for elisp (elisprs) — Emacs Lisp on the fusevm bytecode VM.

_elisp() {
  _arguments -s \
    '(- *)'{-V,--version}'[print version and exit]' \
    '(- *)'{-h,--help}'[show usage and exit]' \
    '(- *)--lsp[run the language server over stdio]' \
    '(- *)--dap[run the debug adapter over stdio]' \
    '--aot[ahead-of-time compile to a native object]' \
    '--aot-exe[ahead-of-time compile to a standalone native executable]' \
    '--repl[start the interactive REPL]' \
    '--tiers[run it, then report which fusevm tiers took its chunks]' \
    '(- *)--cache-stats[print bytecode-cache statistics and exit]' \
    '(- *)--cache-clear[delete the bytecode cache and exit]' \
    '-o[output object path (with --aot)]:output file:_files' \
    '--dump-tokens[print the reader lexical token stream]:Emacs Lisp file:_files -g "*.el"' \
    '--dump-ast[print the read s-expression forms (AST)]:Emacs Lisp file:_files -g "*.el"' \
    '--dump-bytecode[print the compiled fusevm ops]:Emacs Lisp file:_files -g "*.el"' \
    '--disasm[print a fusevm bytecode disassembly]:Emacs Lisp file:_files -g "*.el"' \
    '--script[evaluate a file as `emacs --script` does (standard syntax table)]' \
    {-e,--eval}'[evaluate an expression and print its value]:expression' \
    '*:Emacs Lisp file:_files -g "*.el"'
}

_elisp "$@"
