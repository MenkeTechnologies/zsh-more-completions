#compdef cheat
# Documentation: https://man.archlinux.org/search?q=cheat
# Reference accessed: 2026-05-16

# Zsh completion for `cheat`, the cheat.sh client from Bash-Snippets
# (https://github.com/alexanderepstein/Bash-Snippets); flags per `cheat -h`.
# Caches the language list to avoid network calls on every completion

local cache_file="${XDG_CACHE_HOME:-$HOME/.cache}/cheat_sh_list"
local -a cheat_langs

# Cache the list for 24 hours
if [[ -f "$cache_file" && -n "$(find "$cache_file" -mtime -1 2>/dev/null)" ]]; then
  cheat_langs=("${(@f)$(< "$cache_file")}")
elif (( $+commands[curl] )); then
  curl -s cheat.sh/:list 2>/dev/null > "$cache_file" &!
  [[ -f "$cache_file" ]] && cheat_langs=("${(@f)$(< "$cache_file")}")
fi

_arguments -s -C \
  '-s[search for the last argument rather than an exact match]' \
  '-i[case-insensitive search]' \
  '-b[match word boundaries in the search]' \
  '-r[recursive search]' \
  '(- *)-u[update the Bash-Snippets tools]' \
  '(- *)-h[show help]' \
  '(- *)-v[show the tool version]' \
  '1:cheat sheet:compadd -a cheat_langs' \
  '2:special page:((hello\:"build the hello world program" list\:"list the cheat sheets for the language" learn\:"learn-x-in-minutes sheet" 1line\:"one-liners in the language" weirdness\:"weird things in the language"))' \
  '*::query:_message "search query"'
