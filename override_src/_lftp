#compdef lftp
# Documentation: https://man.archlinux.org/search?q=lftp
# Reference accessed: 2026-05-16

local expl bookmarks
local XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}

bookmarks=$XDG_DATA_HOME/$service/bookmarks

if [[ -f $bookmarks ]]; then
  bookmarks=(${"${(f)$(<$bookmarks)}"%%[[:space:],]*})
  _wanted bookmarks expl bookmark compadd -a bookmarks && return 0
fi

local -a arguments

arguments=(
  # lftp(1) OPTIONS, plus the `open` options it also accepts (lftp 4.9).
  '(-c -e -u --user --password --env-password -p -s -d -B *)-f[execute commands from the file and exit]:script file:_files'
  '(-f -e -u --user --password --env-password -p -s -d -B *)-c[execute the given commands and exit]:commands'
  '--norc[do not execute rc files from the home directory]'
  '*--rcfile[execute commands from the file]:rc file:_files'
  '(- *)'{-h,--help}'[print help and exit]'
  '(- *)--version[print lftp version and exit]'
  '-e[execute the commands just after selecting the site]:commands'
  '(--user)-u[use the user\[,password\] for authentication]:user\[,pass\]'
  '(-u)--user[use the user for authentication]:user'
  '--password[use the password for authentication]:password'
  '--env-password[take the password from LFTP_PASSWORD]'
  '-p[use the port for the connection]:port'
  '-s[assign the connection to this slot]:slot'
  '-d[switch on debugging mode]'
  '-B[do not look up bookmarks]'
  '*:site:_urls'
)

_arguments -s $arguments
