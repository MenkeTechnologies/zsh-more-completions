#compdef zshrs

local curcontext=$curcontext state state_descr line expl not='!' ret=1
local -a book_opts
typeset -A opt_args

[[ $CURRENT = 2 ]] && not=''

# Per-session cache of every LSP-known canonical name (builtins /
# keywords / options / specials / compsys / extensions / operators).
# Three layered sources (first hit wins):
#   1. `$ZSHRS_LSP_WORDS_FILE` env override — for power-users who keep
#      a custom word-list at a known path.
#   2. The committed static snapshot at the completions dir's sibling
#      `lsp_completion_words.txt` — mirrors stryke's same-named file;
#      regenerate with `scripts/gen_lsp_completion_words.sh`.
#   3. Dynamic `zshrs --names` fallback for fresh checkouts where the
#      snapshot hasn't been generated yet (spawns the binary once
#      per shell session — ~30 ms cold).
if (( ! ${+_zshrs_doc_names_cache} )); then
    _zshrs_doc_names_cache=()
    local _zshrs_words_file
    if [[ -n "${ZSHRS_LSP_WORDS_FILE:-}" && -r "$ZSHRS_LSP_WORDS_FILE" ]]; then
        _zshrs_words_file="$ZSHRS_LSP_WORDS_FILE"
    else
        # Resolve the path relative to this completer file (`$0`).
        _zshrs_words_file="${${(%):-%x}:A:h}/lsp_completion_words.txt"
    fi
    if [[ -r "$_zshrs_words_file" ]]; then
        _zshrs_doc_names_cache=( ${(f)"$(<$_zshrs_words_file)"} )
    else
        _zshrs_doc_names_cache=( ${(f)"$(command zshrs --names 2>/dev/null)"} )
    fi
fi

# Words _arguments cannot place, handled first:
#   zshrs --csh-translate [--] [--source] FILE|-   (argv[1] only, bins/zshrs.rs)
#   zshrs --docs -s|--search PATTERN               (docs_book.rs `run`)
if [[ $words[2] == --csh-translate ]]; then
  if (( CURRENT == 3 )); then
    _alternative \
      'source-mode:option:((--source\:"translate as text a csh source runs: its exit leaves only that file"))' \
      'files:csh script (- for stdin):_files' && ret=0
  elif (( CURRENT == 4 )) && [[ $words[3] == --source ]]; then
    _files && ret=0
  fi
  return ret
fi
if (( CURRENT > 3 )) && [[ $words[CURRENT-2] == --docs && $words[CURRENT-1] == (-s|--search) ]]; then
  _message -e patterns 'search pattern'
  return 0
fi

_arguments -S -s : \
  ${not}'--emulate[specify emulation mode]:mode:(zsh sh ksh csh bash)' \
  '--bash[parity-mode drop-in for /bin/bash (caches OFF, daemon OFF)]' \
  '--ksh[parity-mode drop-in for /bin/ksh (ksh-93)]' \
  '--sh[parity-mode drop-in for /bin/sh / POSIX (alias of --posix)]' \
  '--csh[parity-mode drop-in for /bin/csh]' \
  '--dash[parity-mode drop-in for dash]' \
  '--ash[parity-mode drop-in for ash]' \
  '--mksh[parity-mode drop-in for mksh]' \
  '--pdksh[parity-mode drop-in for pdksh]' \
  '*-o+[set named option]:option:_options' \
  '*+o+[unset named option]:option:_options' \
  '(1 -s --shinstdin)'{-s,--shinstdin}'[read commands from standard input]' \
  '(-)-b[end of option processing, like --]' \
  '(1 -)-c[run a command]:command:_cmdstring' \
  '(-)--help[show help message and exit]' \
  '(-)--version[show version number and exit]' \
  '(1 *)--doctor[full diagnostic report of shell health, caches, and performance]' \
  '--json[with --doctor: the same report as one JSON object]' \
  ${not}'(- 1 *)--csh-translate[print the zsh translation of a csh script]' \
  '(-)--banner[print the ZSHRS logo, version and builtin totals, and daemon status]' \
  '(-)--prewarm-autoloads[compile every _* completer on \$fpath into autoloads.rkyv]' \
  '--disasm[print fusevm bytecode to stdout before each VM run]' \
  '--zsh-compat[enable zsh compatibility mode (use .zcompdump, fpath scanning)]' \
  '--zsh[alias for --zsh-compat]' \
  '--posix[POSIX strict mode (no SQLite, no worker pool, no zsh extensions)]' \
  '--norc[with --bash: do not read /etc/bash.bashrc or ~/.bashrc]' \
  '--noprofile[with --bash: do not read /etc/profile or the ~/.bash_profile family]' \
  '(--init-file)--rcfile[with --bash: read FILE instead of ~/.bashrc]:startup file:_files' \
  '(--rcfile)--init-file[with --bash: read FILE instead of ~/.bashrc]:startup file:_files' \
  '--no-rcs[do not source startup files]' \
  '-f[equivalent to --no-rcs]' \
  '-i[force interactive mode]' \
  '(-l --login)'{-l,--login}'[force login shell mode]' \
  '(-v --verbose)'{-v,--verbose}'[verbose (log every command before execution)]' \
  '(-x --xtrace)'{-x,--xtrace}'[xtrace (print expanded commands to stderr)]' \
  '--dump-zwc[list a compiled .zwc cache, or one function from it]:zwc file:_files -g "*.zwc":function name' \
  '--dump-tokens[dump lexer tokens for a script]:script:_files' \
  '--dump-ast[dump parser AST as S-expression]:script:_files' \
  '--dump-wordcode[dump wordcode emitter output]:script:_files' \
  '--dump-reflection[emit the JSON consumed by the IntelliJ reflection tool window]' \
  '--dump-reference-html[emit the HTML chapter sections for docs/reference.html]' \
  '--names[print every LSP-known canonical name, one per line]' \
  '--gen-docs[walk PATH for shell sources, emit Markdown module docs]:path:_directories' \
  '--out[output directory for --gen-docs (default `docs/`)]:dir:_directories' \
  '(1 *)--docs[open the reference book, or print the entry for a topic or page]::topic, page or book option:->docnames' \
  '--color[ANSI color in --docs output]:mode:(auto always never)' \
  '--lsp[run the in-process LSP server over stdio]' \
  '--dump-plugins[emit JSON for every sourced plugin, grouped by manager]' \
  '--fmt[format zsh source (stdin->stdout, or in place with -w)]' \
  '-w[with --fmt: rewrite files in place]' \
  '-t[with --fmt: indent with tabs]' \
  '--tiers[run a script, then report which fusevm tier took each chunk]:script:_files' \
  '--ztest[run the builtin unit-test framework on a worker pool]' \
  '-j+[with --ztest: worker process count]:workers' \
  '-q[with --ztest: suppress per-file banners]' \
  '--quiet[with --ztest: suppress per-file banners]' \
  '--dap[run the in-process DAP debugger (TCP connect-back; stdio if no addr)]::host\:port' \
  '(-)1:script file:_files' \
  '*::script arguments:->args' -- -i '*/*' && ret=0

# `&& ret=0`, not `&& return 0`: for an optional option argument
# (`--docs::…`) `_arguments` sets $state AND returns 0 once any other
# spec added matches, so returning early would skip the state below.
case $state in
  (docnames)
    # `zshrs --names` is name-only (no per-entry kind), so the names go
    # in as one flat group. `compadd -a`, not `_values`: names such as
    # `[[`, `((`, `:=` and `<(` are spec syntax to `_values`.
    # Only the first word after --docs is an option
    # (src/extensions/docs_book.rs `run`): -t/-l/-s/-h, a page number,
    # or a topic name.
    book_opts=(
      {-t,--toc}':table of contents with the page of every topic'
      {-l,--list}':every topic, one per line'
      {-s,--search}':topics whose name or text contains a pattern'
      {-h,--help}':usage and the keys of the book'
    )
    _describe -t book-options 'book option' book_opts && ret=0
    _message -e page-numbers 'page number'
    _wanted doc-names expl 'zshrs doc name' compadd -a _zshrs_doc_names_cache && ret=0
    ;;
  (args)
    if [[ -n ${opt_args[(I)-c|-s|--shinstdin]} ]]; then
      _files && ret=0
    else
      _normal && ret=0
    fi
    ;;
esac

return ret
